{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "test:e2e": "playwright test",
    "ci": "npm run typecheck && npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
