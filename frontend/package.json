    "@tanstack/react-router": "^1.170.36",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.2.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dompurify": "^3.4.13",
    "focus-trap-react": "^12.0.3",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.13",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
