{
  "manifest_version": 3,
  "name": "Vandalizer Browser",
  "version": "2.0.0",
  "description": "Lets Vandalizer chat read the sites you allow, in your own browser and signed in as you. Read-only.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
